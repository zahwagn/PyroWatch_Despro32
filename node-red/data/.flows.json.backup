    {
        "id": "f241f05ef5f5c3e6",
        "type": "function",
        "z": "59a5896486c42da9",
        "name": "hitung FRI",
        "func": "const d = msg.payload;\n\n// Normalisasi suhu\nfunction fT(T) {\n    if (T < 25) return 0;\n    if (T > 55) return 1;\n    return (T - 25) / (55 - 25);\n}\n\n// Normalisasi kelembapan (inversi)\nfunction fH(H) {\n    if (H < 30) return 1;\n    if (H > 90) return 0;\n    return (90 - H) / (90 - 30);\n}\n\n// Normalisasi gas CO dan CH4, ambil max\nfunction fG(co, ch4) {\n    const fCO  = Math.min(Math.max(co / 200, 0), 1);\n    const fCH4 = Math.min(Math.max(ch4 / 1000, 0), 1);\n    return Math.max(fCO, fCH4);\n}\n\n// Normalisasi kecepatan angin dari anemometer\nfunction fW(w) {\n    return Math.min(Math.max(w / 15, 0), 1); // max 15 m/s\n}\n\n// Hitung FRI dasar \nconst fri_base = (0.3 * fT(d.temp)) + (0.2 * fH(d.hum)) + (0.5 * fG(d.co, d.ch4));\n\n// Faktor penguat dari angin (1.0 - 1.2)\nconst wind_multiplier = 1.0 + (0.2 * fW(d.wind_speed));\n\n// FRI final, di-cap di 1.0\nconst fri = Math.min(fri_base * wind_multiplier, 1.0);\n\n// Klasifikasi level\nlet fri_level;\nif      (fri < 0.4)  fri_level = \"Low\";\nelse if (fri <= 0.6) fri_level = \"Moderate\";\nelse if (fri <= 0.8) fri_level = \"High\";\nelse                 fri_level = \"Extreme\";\n\n// BARU: Estimasi laju rambatan api dari kecepatan angin\nconst spread_rate = parseFloat((2.0 * Math.exp(0.3 * d.wind_speed)).toFixed(2));\n\n// Simpan ke flow context untuk diakses node LLM nanti\nflow.set(\"last_fri_data\", {\n    ...d,\n    fri_base: parseFloat(fri_base.toFixed(4)),\n    fri: parseFloat(fri.toFixed(2)),\n    fri_level: fri_level,\n    spread_rate_cmph: spread_rate\n});\n\nmsg.payload = {\n    ...d,\n    fri_base: parseFloat(fri_base.toFixed(4)),\n    fri: parseFloat(fri.toFixed(2)),\n    fri_level: fri_level,\n    spread_rate_cmph: spread_rate\n};\n\nnode.status({\n    fill: fri_level === \"Low\" ? \"green\" :\n          fri_level === \"Moderate\" ? \"yellow\" :\n          fri_level === \"High\" ? \"orange\" : \"red\",\n    shape: \"dot\",\n    text: `FRI: ${fri.toFixed(2)} (${fri_level}) | Angin: ${d.wind_speed} m/s`\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 690,
        "y": 280,
        "wires": [
            [
                "033f22e6eff3ac2a"
            ]
        ]
    },
    {
        "id": "033f22e6eff3ac2a",
        "type": "function",
        "z": "59a5896486c42da9",
        "name": "insert query",
        "func": "const d = msg.payload;\nmsg.params = {\n    $node_id:          d.node_id,\n    $timestamp:        d.timestamp,\n    $co:               d.co,\n    $ch4:              d.ch4,\n    $temp:             d.temp,\n    $hum:              d.hum,\n    $wind_speed:       d.wind_speed ?? null,        \n    $fri:              d.fri ?? null,\n    $fri_level:        d.fri_level ?? null,\n    $spread_rate_cmph: d.spread_rate_cmph ?? null   \n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 690,
        "y": 340,
        "wires": [
            [
                "164a7c4a1ec4e4e1"
            ]
        ]
    },
    {
        "id": "164a7c4a1ec4e4e1",
        "type": "sqlite",
        "z": "59a5896486c42da9",
        "mydb": "f09fc80afd185003",
        "sqlquery": "prepared",
        "sql": "INSERT INTO sensor_readings \n(node_id, timestamp, co, ch4, temp, hum, wind_speed, fri, fri_level, spread_rate_cmph)\nVALUES \n($node_id, $timestamp, $co, $ch4, $temp, $hum, $wind_speed, $fri, $fri_level, $spread_rate_cmph)",
        "name": "",
        "x": 720,
        "y": 400,
        "wires": [
            [
                "4aeb1887fa825b89"
            ]
        ]
    },
    {
        "id": "4aeb1887fa825b89",
        "type": "function",
        "z": "59a5896486c42da9",
        "name": "format prompt LLM",
        "func": "const d = flow.get(\"last_fri_data\") || msg.payload;\n\nconst systemPrompt = `\nAnda adalah AI analisis risiko kebakaran hutan untuk sistem PyroWatch.\n\nTugas:\n1. Analisis kondisi berdasarkan data sensor dan FRI.\n2. Jelaskan risiko secara singkat.\n3. Jelaskan potensi penyebaran secara singkat.\n4. Berikan maksimal 3 rekomendasi.\n\nWAJIB:\n- Output HARUS JSON valid.\n- Jangan gunakan Markdown.\n- Jangan gunakan backtick.\n- Jangan menambahkan teks sebelum atau sesudah JSON.\n- Semua nilai string harus singkat.\n- Maksimal 1-2 kalimat untuk analisis_risiko.\n- Maksimal 1 kalimat untuk estimasi_penyebaran.\n- rekomendasi maksimal 3 item.\n- Gunakan Bahasa Indonesia.\n\nFormat JSON WAJIB:\n\n{\n  \"analisis_risiko\": \"string\",\n  \"estimasi_penyebaran\": \"string\",\n  \"rekomendasi\": [\n    \"string\",\n    \"string\",\n    \"string\"\n  ],\n  \"tingkat_urgensi\": \"Low|Moderate|High|Extreme\"\n}\n`;\n\nconst userPrompt = `\nData sensor PyroWatch:\n\nNode: ${d.node_id}\nTimestamp: ${d.timestamp}\n\nTemperature: ${d.temp} °C\nHumidity: ${d.hum} %\nCO: ${d.co}\nCH4: ${d.ch4}\nWind speed: ${d.wind_speed} m/s\n\nFRI: ${d.fri}\nFRI level: ${d.fri_level}\nSpread rate: ${d.spread_rate_cmph} cm/h\n\nBerikan analisis sesuai format JSON.\nJangan membuat penjelasan panjang.\n`;\n\nmsg.payload = {\n    contents: [\n        {\n            parts: [\n                {\n                    text: systemPrompt + \"\\n\" + userPrompt\n                }\n            ]\n        }\n    ],\n\n    generationConfig: {\n        temperature: 0.1,\n\n        maxOutputTokens: 2048,\n\n        responseMimeType: \"application/json\"\n    }\n};\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\",\n    \"x-goog-api-key\": env.get(\"GEMINI_API_KEY\")\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 710,
        "y": 460,
        "wires": [
            [
                "83989e26696607fb"
            ]
        ]
    },
    {
        "id": "83989e26696607fb",
        "type": "http request",
        "z": "59a5896486c42da9",
        "name": "",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 690,
        "y": 520,
        "wires": [
            [
                "c7eff421508420d8"
            ]
        ]
    },
    {
        "id": "c7eff421508420d8",
        "type": "function",
        "z": "59a5896486c42da9",
        "name": "parse response LLM",
        "func": "// DEBUG: lihat seluruh response dari Gemini\nnode.warn(\"=== GEMINI RAW RESPONSE ===\");\nnode.warn(JSON.stringify(msg.payload, null, 2));\n\n// Cek HTTP status\nif (msg.statusCode && msg.statusCode !== 200) {\n    node.error(\n        `Gemini HTTP Error ${msg.statusCode}: ${JSON.stringify(msg.payload)}`,\n        msg\n    );\n    return null;\n}\n\n// Cek apakah payload ada\nif (!msg.payload) {\n    node.error(\"Response Gemini benar-benar kosong\", msg);\n    return null;\n}\n\n// Cek error dari Gemini\nif (msg.payload.error) {\n    node.error(\n        `Gemini API Error: ${JSON.stringify(msg.payload.error)}`,\n        msg\n    );\n    return null;\n}\n\n// Cek candidates\nconst candidates = msg.payload.candidates;\n\nif (!candidates || candidates.length === 0) {\n\n    const reason =\n        msg.payload.promptFeedback?.blockReason ||\n        msg.payload.promptFeedback ||\n        \"Tidak ada candidates dari Gemini\";\n\n    node.error(\n        \"Gemini tidak mengembalikan candidate. Detail: \" +\n        JSON.stringify(reason),\n        msg\n    );\n\n    return null;\n}\n\n// Ambil text dari response\nconst parts = candidates[0]?.content?.parts || [];\n\nconst textPart = parts.find(\n    p => typeof p.text === \"string\" && p.text.trim() !== \"\"\n);\n\nif (!textPart) {\n    node.error(\n        \"Candidate Gemini ada, tetapi tidak ada text. Response: \" +\n        JSON.stringify(candidates[0]),\n        msg\n    );\n    return null;\n}\n\nconst raw = textPart.text.trim();\n\nnode.warn(\"=== GEMINI TEXT ===\");\nnode.warn(raw);\n\nlet parsed;\n\ntry {\n    parsed = JSON.parse(raw);\n} catch (e) {\n\n    try {\n        const cleaned = raw\n            .replace(/^```json\\s*/i, \"\")\n            .replace(/^```\\s*/i, \"\")\n            .replace(/\\s*```$/i, \"\")\n            .trim();\n\n        parsed = JSON.parse(cleaned);\n\n    } catch (e2) {\n\n        node.error(\n            \"Gemini mengembalikan text tetapi bukan JSON valid: \" +\n            raw,\n            msg\n        );\n\n        return null;\n    }\n}\n\nconst sensorData = flow.get(\"last_fri_data\") || {};\n\nmsg.payload = {\n    ...sensorData,\n    llm_insight: parsed\n};\n\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: \"LLM OK — \" + (parsed.tingkat_urgensi || \"Unknown\")\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 720,
        "y": 580,
        "wires": [
            [
                "ae90330909f69495",
                "d8c0bb413024b756",
                "9116b5b663c4a9ca"
            ]
        ]
    },
