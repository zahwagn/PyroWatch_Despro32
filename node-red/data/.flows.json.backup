        "func": "   msg.topic = `CREATE TABLE IF NOT EXISTS sensor_readings (\n       id INTEGER PRIMARY KEY AUTOINCREMENT,\n       node_id TEXT,\n       timestamp TEXT,\n       co REAL,\n       ch4 REAL,\n       temp REAL,\n       hum REAL,\n       fri REAL,\n       fri_level TEXT\n   )`;\n   return msg;",
