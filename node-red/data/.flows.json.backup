        "wires": []
    },
    {
        "id": "f241f05ef5f5c3e6",
        "type": "function",
        "z": "59a5896486c42da9",
        "name": "hitung FRI",
        "func": "const d = msg.payload;\n\n// Normalisasi suhu (T_min=25, T_max=55)\nfunction fT(T) {\n    if (T < 25) return 0;\n    if (T > 55) return 1;\n    return (T - 25) / (55 - 25);\n}\n\n// Normalisasi kelembapan, inversi (H_min=30, H_max=90)\nfunction fH(H) {\n    if (H < 30) return 1;\n    if (H > 90) return 0;\n    return (90 - H) / (90 - 30);\n}\n\n// Normalisasi gas CO (0-200 ppm) dan CH4 (0-1000 ppm), ambil max\nfunction fG(co, ch4) {\n    const fCO = Math.min(Math.max(co / 200, 0), 1);\n    const fCH4 = Math.min(Math.max(ch4 / 1000, 0), 1);\n    return Math.max(fCO, fCH4);\n}\n\nconst fri = (0.3 * fT(d.temp)) + (0.2 * fH(d.hum)) + (0.5 * fG(d.co, d.ch4));\n\nlet level;\nif (fri < 0.4) level = \"Low\";\nelse if (fri <= 0.6) level = \"Moderate\";\nelse if (fri <= 0.8) level = \"High\";\nelse level = \"Extreme\";\n\nmsg.payload = {\n    ...d,\n    fri: Number(fri.toFixed(2)),\n    fri_level: level\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 280,
        "wires": [
            [
                "033f22e6eff3ac2a"
            ]
        ]
    },
    {
        "id": "033f22e6eff3ac2a",
        "type": "function",
        "z": "59a5896486c42da9",
        "name": "insert query",
        "func": "const d = msg.payload;\nmsg.topic = \"INSERT INTO sensor_readings (node_id, timestamp, co, ch4, temp, hum, fri, fri_level) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\";\nmsg.payload = [d.node_id, d.timestamp, d.co, d.ch4, d.temp, d.hum, d.fri ?? null, d.fri_level ?? null];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 340,
        "wires": [
            [
                "164a7c4a1ec4e4e1"
            ]
        ]
    },
