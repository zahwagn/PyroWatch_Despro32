    {
        "id": "cbb31a8c52962806",
        "type": "function",
        "z": "59a5896486c42da9",
        "name": "parse & validasi",
        "func": "const payload = msg.payload;\nconst required = [\"co\", \"ch4\", \"temp\", \"hum\", \"node_id\"];\nconst missing = required.filter(k => !(k in payload));\n\nif (missing.length > 0) {\n    node.warn(\"Payload tidak lengkap, field hilang: \" + missing.join(\",\"));\n    return null; // stop flow kalau data tidak sesuai\n}\n\nmsg.payload = {\n    ...payload,\n    timestamp: new Date().toISOString()\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 200,
        "wires": [
            [
                "f241f05ef5f5c3e6"
            ]
        ]
    },
