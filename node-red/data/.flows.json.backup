    {
        "id": "cbb31a8c52962806",
        "type": "function",
        "z": "59a5896486c42da9",
        "name": "parse & validasi",
        "func": "const payload = msg.payload;\n\n// Tambah wind_speed ke required field\nconst required = [\"co\", \"ch4\", \"temp\", \"hum\", \"node_id\", \"wind_speed\"];\nconst missing = required.filter(k => !(k in payload));\n\nif (missing.length > 0) {\n    node.warn(\"Payload tidak lengkap, field hilang: \" + missing.join(\",\"));\n    return null;\n}\n\n// Validasi range nilai\nconst checks = [\n    { field: \"temp\",       min: -40,  max: 80    },\n    { field: \"hum\",        min: 0,    max: 100   },\n    { field: \"co\",         min: 0,    max: 2000  },\n    { field: \"ch4\",        min: 0,    max: 10000 },\n    { field: \"wind_speed\", min: 0,    max: 60    }\n];\n\nfor (const check of checks) {\n    const val = payload[check.field];\n    if (val < check.min || val > check.max) {\n        node.warn(`Field ${check.field} out of range: ${val}`);\n        return null;\n    }\n}\n\nmsg.payload = {\n    ...payload,\n    timestamp: new Date().toISOString()\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 200,
        "wires": [
            [
                "f241f05ef5f5c3e6"
            ]
        ]
    },
    {
        "id": "ae90330909f69495",
