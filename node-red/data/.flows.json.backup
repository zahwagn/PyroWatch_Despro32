    {
        "id": "d8c0bb413024b756",
        "type": "function",
        "z": "59a5896486c42da9",
        "name": "insert LLM insight",
        "func": "const d = msg.payload;\n\nconst insight = d.llm_insight || {};\n\nmsg.params = {\n    $node_id: d.node_id,\n    $timestamp: d.timestamp,\n\n    $analisis_risiko:\n        insight.analisis_risiko || null,\n\n    $estimasi_penyebaran:\n        insight.estimasi_penyebaran || null,\n\n    $rekomendasi:\n        Array.isArray(insight.rekomendasi)\n            ? JSON.stringify(insight.rekomendasi)\n            : null,\n\n    $tingkat_urgensi:\n        insight.tingkat_urgensi || null\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 700,
        "wires": [
            [
                "4898adb7d6158e70"
            ]
        ]
    },
    {
        "id": "4898adb7d6158e70",
        "type": "sqlite",
        "z": "59a5896486c42da9",
        "mydb": "f09fc80afd185003",
        "sqlquery": "prepared",
        "sql": "INSERT INTO llm_insights\n(\n    node_id,\n    timestamp,\n    analisis_risiko,\n    estimasi_penyebaran,\n    rekomendasi,\n    tingkat_urgensi\n)\nVALUES\n(\n    $node_id,\n    $timestamp,\n    $analisis_risiko,\n    $estimasi_penyebaran,\n    $rekomendasi,\n    $tingkat_urgensi\n);",
        "name": "",
        "x": 600,
        "y": 760,
        "wires": [
            []
        ]
    },
    {
        "id": "9116b5b663c4a9ca",
        "type": "ui-template",
        "z": "59a5896486c42da9",
        "group": "073feec3ce7fb5e5",
        "page": "",
        "ui": "",
        "name": "AI Risk Monitoring",
        "order": 1,
        "width": "0",
        "height": "0",
        "head": "",
        "format": "<template>\n    <div class=\"pyrowatch-dashboard\">\n\n        <!-- HEADER -->\n        <div class=\"header\">\n            <div>\n                <h1>🔥 PyroWatch</h1>\n                <p>Wildfire Risk Monitoring & AI Analysis</p>\n            </div>\n\n            <div\n                v-if=\"msg && msg.payload\"\n                class=\"risk-badge\"\n                :class=\"getRiskClass(msg.payload.fri_level)\"\n            >\n                {{ msg.payload.fri_level || 'Unknown' }}\n            </div>\n        </div>\n\n\n        <!-- SENSOR DATA -->\n        <div\n            v-if=\"msg && msg.payload\"\n            class=\"sensor-grid\"\n        >\n\n            <!-- FRI -->\n            <div class=\"card\">\n                <div class=\"card-title\">🔥 Fire Risk Index</div>\n\n                <div class=\"big-value\">\n                    {{ formatNumber(msg.payload.fri) }}\n                </div>\n\n                <div class=\"progress\">\n                    <div\n                        class=\"progress-bar\"\n                        :style=\"{ width: ((msg.payload.fri || 0) * 100) + '%' }\"\n                    ></div>\n                </div>\n            </div>\n\n\n            <!-- TEMPERATURE -->\n            <div class=\"card\">\n                <div class=\"card-title\">🌡️ Temperature</div>\n\n                <div class=\"big-value\">\n                    {{ formatNumber(msg.payload.temp) }} °C\n                </div>\n            </div>\n\n\n            <!-- HUMIDITY -->\n            <div class=\"card\">\n                <div class=\"card-title\">💧 Humidity</div>\n\n                <div class=\"big-value\">\n                    {{ formatNumber(msg.payload.hum) }} %\n                </div>\n            </div>\n\n\n            <!-- WIND -->\n            <div class=\"card\">\n                <div class=\"card-title\">💨 Wind Speed</div>\n\n                <div class=\"big-value\">\n                    {{ formatNumber(msg.payload.wind_speed) }} m/s\n                </div>\n            </div>\n\n\n            <!-- CO -->\n            <div class=\"card\">\n                <div class=\"card-title\">☁️ CO</div>\n\n                <div class=\"big-value\">\n                    {{ formatNumber(msg.payload.co) }}\n                </div>\n            </div>\n\n\n            <!-- CH4 -->\n            <div class=\"card\">\n                <div class=\"card-title\">⚠️ CH₄</div>\n\n                <div class=\"big-value\">\n                    {{ formatNumber(msg.payload.ch4) }}\n                </div>\n            </div>\n\n        </div>\n\n\n        <!-- SPREAD RATE -->\n        <div\n            v-if=\"msg && msg.payload\"\n            class=\"card spread-card\"\n        >\n            <div class=\"card-title\">\n                🔥 Estimated Fire Spread\n            </div>\n\n            <div class=\"spread-value\">\n                {{ formatNumber(msg.payload.spread_rate_cmph) }} cm/h\n            </div>\n        </div>\n\n\n        <!-- AI ANALYSIS -->\n        <div\n            v-if=\"msg && msg.payload && msg.payload.llm_insight\"\n            class=\"ai-section\"\n        >\n\n            <div class=\"ai-header\">\n                <h2>🤖 AI Risk Analysis</h2>\n\n                <span\n                    class=\"urgency\"\n                    :class=\"getUrgencyClass(\n                        msg.payload.llm_insight.tingkat_urgensi\n                    )\"\n                >\n                    {{ msg.payload.llm_insight.tingkat_urgensi || 'Unknown' }}\n                </span>\n            </div>\n\n\n            <!-- ANALISIS RISIKO -->\n            <div class=\"ai-card\">\n                <h3>📊 Analisis Risiko</h3>\n\n                <p>\n                    {{ msg.payload.llm_insight.analisis_risiko }}\n                </p>\n            </div>\n\n\n            <!-- ESTIMASI PENYEBARAN -->\n            <div class=\"ai-card\">\n                <h3>🔥 Estimasi Penyebaran</h3>\n\n                <p>\n                    {{ msg.payload.llm_insight.estimasi_penyebaran }}\n                </p>\n            </div>\n\n\n            <!-- REKOMENDASI -->\n            <div class=\"ai-card\">\n                <h3>🛡️ Rekomendasi</h3>\n\n                <ul\n                    v-if=\"Array.isArray(\n                        msg.payload.llm_insight.rekomendasi\n                    )\"\n                >\n                    <li\n                        v-for=\"(item, index) in\n                        msg.payload.llm_insight.rekomendasi\"\n                        :key=\"index\"\n                    >\n                        {{ item }}\n                    </li>\n                </ul>\n\n                <p\n                    v-else\n                >\n                    {{ msg.payload.llm_insight.rekomendasi }}\n                </p>\n            </div>\n\n        </div>\n\n\n        <!-- INFORMATION -->\n        <div\n            v-if=\"msg && msg.payload\"\n            class=\"info\"\n        >\n            <div>\n                <strong>Node:</strong>\n                {{ msg.payload.node_id }}\n            </div>\n\n            <div>\n                <strong>Timestamp:</strong>\n                {{ msg.payload.timestamp }}\n            </div>\n        </div>\n\n\n        <!-- NO DATA -->\n        <div\n            v-if=\"!msg || !msg.payload\"\n            class=\"no-data\"\n        >\n            <div class=\"no-data-icon\">📡</div>\n            <h2>Waiting for sensor data...</h2>\n            <p>PyroWatch is waiting for incoming MQTT data.</p>\n        </div>\n\n    </div>\n</template>\n\n\n<style>\n.pyrowatch-dashboard {\n    padding: 20px;\n    font-family: Arial, sans-serif;\n}\n\n\n/* HEADER */\n\n.header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 20px;\n}\n\n.header h1 {\n    margin: 0;\n    font-size: 28px;\n}\n\n.header p {\n    margin: 5px 0 0;\n    opacity: 0.7;\n}\n\n\n/* RISK BADGE */\n\n.risk-badge {\n    padding: 10px 20px;\n    border-radius: 20px;\n    font-weight: bold;\n    font-size: 16px;\n}\n\n\n/* SENSOR GRID */\n\n.sensor-grid {\n    display: grid;\n    grid-template-columns: repeat(6, minmax(140px, 1fr));\n    gap: 12px;\n    width: 100%;\n}\n\n\n/* CARD */\n\n.card {\n    padding: 16px;\n    border-radius: 12px;\n    background: rgba(128, 128, 128, 0.08);\n    margin-bottom: 12px;\n    min-width: 0;\n}\n\n.card-title {\n    font-size: 15px;\n    font-weight: bold;\n    margin-bottom: 10px;\n    opacity: 0.8;\n}\n\n.big-value {\n    font-size: 28px;\n    font-weight: bold;\n}\n\n\n/* FRI */\n\n.progress {\n    height: 8px;\n    background: rgba(128, 128, 128, 0.2);\n    border-radius: 5px;\n    margin-top: 15px;\n    overflow: hidden;\n}\n\n.progress-bar {\n    height: 100%;\n    border-radius: 5px;\n    background: currentColor;\n}\n\n\n/* SPREAD */\n\n.spread-card {\n    margin-top: 10px;\n}\n\n.spread-value {\n    font-size: 25px;\n    font-weight: bold;\n}\n\n\n/* AI */\n\n.ai-section {\n    margin-top: 25px;\n}\n\n.ai-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 15px;\n}\n\n.ai-header h2 {\n    margin: 0;\n}\n\n.ai-card {\n    padding: 18px;\n    margin-bottom: 15px;\n    border-radius: 12px;\n    background: rgba(128, 128, 128, 0.08);\n}\n\n.ai-card h3 {\n    margin-top: 0;\n}\n\n.ai-card p {\n    line-height: 1.6;\n}\n\n.ai-card li {\n    margin-bottom: 8px;\n    line-height: 1.5;\n}\n\n\n/* URGENCY */\n\n.urgency {\n    padding: 8px 15px;\n    border-radius: 15px;\n    font-weight: bold;\n}\n\n\n/* INFO */\n\n.info {\n    margin-top: 20px;\n    padding: 12px;\n    font-size: 13px;\n    opacity: 0.7;\n}\n\n\n/* NO DATA */\n\n.no-data {\n    text-align: center;\n    padding: 50px 20px;\n    opacity: 0.7;\n}\n\n.no-data-icon {\n    font-size: 50px;\n    margin-bottom: 10px;\n}\n</style>\n\n\n<script>\nexport default {\n    methods: {\n\n        formatNumber(value) {\n            if (value === undefined || value === null) {\n                return '-'\n            }\n\n            const number = Number(value)\n\n            if (Number.isNaN(number)) {\n                return value\n            }\n\n            return number.toFixed(2)\n        },\n\n        getRiskClass(level) {\n            if (!level) return ''\n\n            return 'risk-' + level\n                .toLowerCase()\n                .replace(/\\s+/g, '-')\n        },\n\n        getUrgencyClass(level) {\n            if (!level) return ''\n\n            return 'urgency-' + level\n                .toLowerCase()\n                .replace(/\\s+/g, '-')\n        }\n    }\n}\n</script>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 850,
        "y": 720,
        "wires": [
            []
        ]
    },
